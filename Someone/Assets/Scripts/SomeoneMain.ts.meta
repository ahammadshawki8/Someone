  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">SomeoneMain - rescue flow orchestrator</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">References</span>"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input SceneObject rescueSpace {"hint":"Root of the rescue space (figure, target, ring, cards). Moved in front of the user at start."}'
    - '// @input AssignableType_1 instructionCard {"hint":"The one instruction card."}'
    - '// @input AssignableType_2 rateCue {"hint":"Pace cue word beside the ring."}'
    - '// @input AssignableType_3 clockChip {"hint":"Time since collapse chip."}'
    - '// @input AssignableType_4 replay {"hint":"End-of-rescue replay."}'
    - '// @input AssignableType_5 chestTarget {"hint":"Chest target (pinch = one compression)."}'
    - '// @input AssignableType_6 paceRing {"hint":"Pace ring around the target."}'
    - '// @input AssignableType_7 metronome {"hint":"Spatial metronome at the chest."}'
    - '// @input AssignableType_8 aedWayfinder {"hint":"AED edge arrow and directional chime."}'
    - '// @input AssignableType_9 aedPads {"hint":"AED pad placement overlay."}'
    - '// @input AssignableType_10 dispatcher {"hint":"Scripted dispatcher captions (stand-in)."}'
    - '// @input AssignableType_11 handCompression {"hint":"Hand-tracked compressions (real glasses). Pinching the target stays the preview stand-in."}'
    - "// @input AssignableType_12 victimReaction {\"hint\":\"The person's chest gives under each push (stand-in figure).\"}"
    - '// @input AssignableType_13 viewShare {"hint":"Viewfinder corners that show the dispatcher now sees your view."}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Settings</span>"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input bool demoMode {"hint":"Shorter timers for the video: AED 0:45, swap 1:05, AED arrives 25 s after Sent, help 10 s after the shock."}'
    - '// @input bool placeInFrontOfUser = true {"hint":"Move the rescue space in front of wherever the user starts. Off = keep the authored position."}'
    - "// @input float chestDistanceCm = 85 {\"hint\":\"Horizontal distance from the eyes to the figure's chest, in cm.\", \"widget\":\"slider\", \"min\":60, \"max\":140, \"step\":1}"
    - '// @input float eyeHeightAboveFloorCm = 75 {"hint":"Floor distance below the eyes, in cm (about 75 for a kneeling rescuer).", "widget":"slider", "min":40, "max":170, "step":1}'
    - '// @input float cueVolume = 0.6 {"hint":"Volume of the button, dispatcher-connect and shock sounds.", "widget":"slider", "min":0, "max":1, "step":0.05}'
    - '// @ui {"widget":"group_end"}'
